{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "python python/server.py",
    "web": "vite --host",
    "tauri": "tauri",
    "test": "vitest run",
    "eval": "vite-node src/eval/run.ts",
    "eval:audit": "vite-node src/eval/audit.ts",
    "tune": "vite-node src/eval/tune.ts",
    "inspect": "vite-node src/eval/inspect.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.eval.json",
    "eval:diag": "vite-node src/eval/diag.ts",
    "eval:splits": "vite-node src/eval/splits.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.183.1",
    "d3": "^7.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
